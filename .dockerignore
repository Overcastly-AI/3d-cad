# Build context is the repo root (deploy/docker/service.Dockerfile).
# Keep the context tiny: only the Python workspace enters the images.

# VCS / agent org / docs
.git
.github
.claude
docs
*.md

# Environments & caches
.venv
**/__pycache__
**/*.py[cod]
.pytest_cache
.ruff_cache
.env
.env.*

# Node / frontend (web image will get its own Dockerfile + ignore rules)
node_modules
apps
packages/design
packages/ts-client
packages/contracts
pnpm-lock.yaml
pnpm-workspace.yaml
package.json
eslint.config.js

# Tests never ship in runtime images
**/tests

# Deploy assets themselves (Dockerfile is passed via -f)
deploy
docker-compose*.yml
justfile
scripts

# …except the licence machinery, which MUST enter the image. A container image
# redistributes every byte in it (docs/LICENSING.md §1): the licence texts are
# an LGPL-2.1 §6 obligation, strip-gpl-jbig.sh removes the GPL-2.0 library the
# OCP wheel vendors, and check-licences.py is the build-time gate that proves
# both. Excluding these silently is exactly how the obligation gets dropped.
!deploy/docker/licence
!deploy/licenses
!scripts/check-licences.py
