            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PartCreate": {
        "description": "Create a part owned by the calling user.",
        "properties": {
          "name": {
            "description": "Part name; unique per owner, whitespace-trimmed, 1-200 characters",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "PartCreate",
        "type": "object"
      },
      "PartListResponse": {
        "description": "The caller's parts, oldest first (wrapper leaves room for pagination).",
        "properties": {
          "parts": {
            "items": {
              "$ref": "#/components/schemas/PartResponse"
            },
            "title": "Parts",
            "type": "array"
          }
        },
        "required": [
          "parts"
        ],
        "title": "PartListResponse",
        "type": "object"
      },
      "PartResponse": {
        "description": "A part as stored \u2014 identity, ownership, and timestamps.\n\nThe feature tree is NOT here yet: it lands as its own tables per\ndocs/design/feature-tree.md once the implementation item ships.",
