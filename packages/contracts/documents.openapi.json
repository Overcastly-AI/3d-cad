            "title": "Owner Id",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "owner_id",
          "created_at",
          "updated_at"
        ],
        "title": "PartResponse",
        "type": "object"
      },
      "ValidationError": {
