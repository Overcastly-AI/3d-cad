  "info": {
    "title": "Loft Documents",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/parts": {
      "get": {
        "description": "The caller's parts, oldest first (deterministic id tiebreak).",
        "operationId": "list_parts_api_v1_parts_get",
        "parameters": [
          {
            "description": "Authenticated user id, forwarded by the gateway (documents is internal and trusts this header).",
            "in": "header",
            "name": "X-Loft-User",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Authenticated user id, forwarded by the gateway (documents is internal and trusts this header).",
              "title": "X-Loft-User"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Parts",
        "tags": [
          "parts"
        ]
      },
      "post": {
        "description": "Create a part (201; envelope 409 on a duplicate name for this owner).",
        "operationId": "create_part_api_v1_parts_post",
        "parameters": [
          {
            "description": "Authenticated user id, forwarded by the gateway (documents is internal and trusts this header).",
            "in": "header",
            "name": "X-Loft-User",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Authenticated user id, forwarded by the gateway (documents is internal and trusts this header).",
              "title": "X-Loft-User"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PartCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Part",
        "tags": [
          "parts"
        ]
      }
    },
    "/api/v1/parts/{part_id}": {
      "delete": {
        "description": "Delete an owned part (204; uniform 404 for unknown/foreign ids).\n\nOnce features exist this gains the design doc's 409-with-dependents\npre-check (docs/design/feature-tree.md \u00a72.3); today a part has no\ndependents, so deletion is unconditional.",
        "operationId": "delete_part_api_v1_parts__part_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "part_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Part Id",
              "type": "string"
            }
          },
          {
            "description": "Authenticated user id, forwarded by the gateway (documents is internal and trusts this header).",
            "in": "header",
            "name": "X-Loft-User",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Authenticated user id, forwarded by the gateway (documents is internal and trusts this header).",
              "title": "X-Loft-User"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Part",
        "tags": [
          "parts"
        ]
      },
      "get": {
        "description": "One owned part (uniform 404 for unknown/foreign ids).",
        "operationId": "get_part_api_v1_parts__part_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "part_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Part Id",
              "type": "string"
            }
          },
          {
            "description": "Authenticated user id, forwarded by the gateway (documents is internal and trusts this header).",
            "in": "header",
            "name": "X-Loft-User",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Authenticated user id, forwarded by the gateway (documents is internal and trusts this header).",
              "title": "X-Loft-User"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Part",
        "tags": [
          "parts"
        ]
      }
    }
  }
}
