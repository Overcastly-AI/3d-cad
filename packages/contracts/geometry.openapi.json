{
  "components": {
    "schemas": {
      "BoundingBox": {
        "description": "Axis-aligned bounding box (mm), exact (not mesh-inflated).",
        "properties": {
          "max": {
            "$ref": "#/components/schemas/Vec3"
          },
          "min": {
            "$ref": "#/components/schemas/Vec3"
          }
        },
        "required": [
          "min",
          "max"
        ],
        "title": "BoundingBox",
        "type": "object"
      },
      "BoxParams": {
        "description": "Axis-aligned box dimensions (mm); the min corner sits at the origin.",
        "properties": {
          "x": {
            "description": "Size along X (mm)",
            "exclusiveMinimum": 0.0,
            "title": "X",
            "type": "number"
          },
          "y": {
            "description": "Size along Y (mm)",
            "exclusiveMinimum": 0.0,
            "title": "Y",
            "type": "number"
          },
          "z": {
            "description": "Size along Z (mm)",
            "exclusiveMinimum": 0.0,
            "title": "Z",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y",
          "z"
        ],
        "title": "BoxParams",
        "type": "object"
      },
      "CylinderParams": {
        "description": "Right circular cylinder (mm): base disc centred at the origin in the\nXY plane, axis along +Z.",
        "properties": {
          "height": {
            "description": "Height along +Z (mm)",
            "exclusiveMinimum": 0.0,
            "title": "Height",
            "type": "number"
          },
          "radius": {
            "description": "Radius (mm)",
            "exclusiveMinimum": 0.0,
            "title": "Radius",
            "type": "number"
          }
        },
        "required": [
          "radius",
          "height"
        ],
        "title": "CylinderParams",
        "type": "object"
      },
      "DatumPlaneRef": {
        "description": "One of the three origin datum planes.",
        "properties": {
          "kind": {
            "const": "datum_plane",
            "title": "Kind",
            "type": "string"
          },
          "plane": {
            "enum": [
              "XY",
              "XZ",
              "YZ"
            ],
            "title": "Plane",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "plane"
        ],
        "title": "DatumPlaneRef",
        "type": "object"
      },
      "EvaluateTreeRequest": {
        "description": "Evaluate an ordered, validated, current-version feature list (\u00a74.2).\n\nDocuments applies the rollback bar BEFORE sending: geometry receives\nexactly the prefix to evaluate and never needs to know rollback exists.",
        "properties": {
          "features": {
            "description": "Ordered prefix (rollback already applied)",
            "items": {
              "$ref": "#/components/schemas/EvaluatedFeatureInput"
            },
            "title": "Features",
            "type": "array"
          },
          "linear_deflection": {
            "default": 0.1,
            "description": "Presentation parameter (mm), NEVER persisted per feature (design \u00a78.3)",
            "exclusiveMinimum": 0.0,
            "title": "Linear Deflection",
            "type": "number"
          },
          "part_id": {
            "format": "uuid",
            "title": "Part Id",
            "type": "string"
          },
          "tree_version": {
            "description": "Echoed back; cache/correlation key",
            "title": "Tree Version",
            "type": "integer"
          }
        },
        "required": [
          "part_id",
          "tree_version",
          "features"
        ],
        "title": "EvaluateTreeRequest",
        "type": "object"
      },
      "EvaluateTreeResult": {
        "description": "Statuses plus object-storage references \u2014 never kernel types, never\ninline meshes (\u00a74.1). A feature failure is a 200 with per-feature errors;\nthe envelope stays reserved for transport/validation failures (\u00a74.3).",
        "properties": {
          "features": {
            "description": "Same order as the request",
            "items": {
              "$ref": "#/components/schemas/FeatureResult"
            },
            "title": "Features",
            "type": "array"
          },
          "last_good_feature_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Which feature the artifact reflects",
            "title": "Last Good Feature Id"
          },
          "mesh_glb_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Object-storage key of the LAST-GOOD body mesh",
            "title": "Mesh Glb Id"
          },
          "part_id": {
            "format": "uuid",
            "title": "Part Id",
            "type": "string"
          },
          "properties": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ShapeProperties"
              },
              {
                "type": "null"
              }
            ],
            "description": "Mass properties of the last-good body"
          },
          "tree_version": {
            "title": "Tree Version",
            "type": "integer"
          }
        },
        "required": [
          "part_id",
          "tree_version",
          "features",
          "mesh_glb_id",
          "properties",
          "last_good_feature_id"
        ],
        "title": "EvaluateTreeResult",
        "type": "object"
      },
      "EvaluatedFeatureInput": {
        "description": "One ordered entry of an evaluation request.",
        "properties": {
          "feature": {
            "discriminator": {
              "mapping": {
                "extrude": "#/components/schemas/ExtrudeFeature",
                "sketch": "#/components/schemas/SketchFeature"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/SketchFeature"
              },
              {
                "$ref": "#/components/schemas/ExtrudeFeature"
              }
            ],
            "title": "Feature"
          },
          "id": {
            "description": "Feature identity for refs + result keying",
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "feature"
        ],
        "title": "EvaluatedFeatureInput",
        "type": "object"
      },
      "ExportRequest": {
        "description": "Build a parametric shape and export it as a downloadable CAD file.\n\nSTEP exports the exact B-rep \u2014 the deflection fields are meaningless for\nit and ignored. STL is a faceted approximation; its quality fields default\nto the tessellation defaults so the exported mesh matches what the\nviewport shows.",
        "properties": {
          "angular_deflection": {
            "default": 0.1,
            "description": "STL facet angular deflection (rad) between adjacent segments; ignored for STEP (exact B-rep)",
            "exclusiveMinimum": 0.0,
            "title": "Angular Deflection",
            "type": "number"
          },
          "format": {
            "description": "Export file format: STEP (exact B-rep) or STL (faceted mesh)",
            "enum": [
              "step",
              "stl"
            ],
            "title": "Format",
            "type": "string"
          },
          "linear_deflection": {
            "default": 0.1,
            "description": "STL facet linear deflection (mm), same semantics as tessellation; ignored for STEP (exact B-rep)",
            "exclusiveMinimum": 0.0,
            "title": "Linear Deflection",
            "type": "number"
          },
          "params": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BoxParams"
              },
              {
                "$ref": "#/components/schemas/CylinderParams"
              }
            ],
            "description": "Parameters of the selected shape kind",
            "title": "Params"
          },
          "shape": {
            "description": "Shape kind; must match the params model",
            "enum": [
              "box",
              "cylinder"
            ],
            "title": "Shape",
            "type": "string"
          }
        },
        "required": [
          "shape",
          "params",
          "format"
        ],
        "title": "ExportRequest",
        "type": "object"
      },
      "ExtrudeFeature": {
        "description": "``{\"type\": \"extrude\", \"version\": 1, \"params\": {...}}`` envelope.",
        "properties": {
          "params": {
            "$ref": "#/components/schemas/ExtrudeParamsV1"
          },
          "type": {
            "const": "extrude",
            "title": "Type",
            "type": "string"
          },
          "version": {
            "const": 1,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "type",
          "version",
          "params"
        ],
        "title": "ExtrudeFeature",
        "type": "object"
      },
      "ExtrudeParamsV1": {
        "description": "Linear extrusion of an earlier sketch feature's profile.",
        "properties": {
          "direction": {
            "default": "normal",
            "enum": [
              "normal",
              "reverse"
            ],
            "title": "Direction",
            "type": "string"
          },
          "distance_mm": {
            "description": "Extrusion depth (mm)",
            "exclusiveMinimum": 0.0,
            "title": "Distance Mm",
            "type": "number"
          },
          "operation": {
            "enum": [
              "add",
              "cut"
            ],
            "title": "Operation",
            "type": "string"
          },
          "profile": {
            "$ref": "#/components/schemas/FeatureRef",
            "description": "Must resolve to an EARLIER sketch feature (design \u00a72.2)"
          }
        },
        "required": [
          "profile",
          "distance_mm",
          "operation"
        ],
        "title": "ExtrudeParamsV1",
        "type": "object"
      },
      "FeatureError": {
        "description": "Why one feature failed to evaluate (\u00a74.3).",
        "properties": {
          "code": {
            "description": "Machine-readable: \"profile_not_closed\", \"boolean_failed\", \"reference_unresolved\", ...",
            "title": "Code",
            "type": "string"
          },
          "message": {
            "description": "Human-readable, kernel detail sanitized",
            "title": "Message",
            "type": "string"
          },
          "upstream_feature_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Set when the root cause is an earlier feature's output",
            "title": "Upstream Feature Id"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "FeatureError",
        "type": "object"
      },
      "FeatureRef": {
        "description": "A whole earlier feature of the same part (e.g. a sketch).",
        "properties": {
          "feature_id": {
            "format": "uuid",
            "title": "Feature Id",
            "type": "string"
          },
          "kind": {
            "const": "feature",
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "feature_id"
        ],
        "title": "FeatureRef",
        "type": "object"
      },
      "FeatureResult": {
        "description": "Per-feature evaluation status. Strict-prefix rule (\u00a74.3): the first\nfailure is ``error``, every subsequent feature ``skipped``.",
        "properties": {
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FeatureError"
              },
              {
                "type": "null"
              }
            ]
          },
          "feature_id": {
            "format": "uuid",
            "title": "Feature Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "error",
              "skipped"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "feature_id",
          "status"
        ],
        "title": "FeatureResult",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MeshStats": {
        "description": "Statistics of the tessellated GLB artifact.",
        "properties": {
          "glb_bytes": {
            "description": "Size of the binary glTF payload in bytes",
            "title": "Glb Bytes",
            "type": "integer"
          },
          "triangles": {
            "title": "Triangles",
            "type": "integer"
          },
          "vertices": {
            "title": "Vertices",
            "type": "integer"
          }
        },
        "required": [
          "vertices",
          "triangles",
          "glb_bytes"
        ],
        "title": "MeshStats",
        "type": "object"
      },
      "ShapeProperties": {
        "description": "Mass properties + topology of the evaluated B-rep shape.",
        "properties": {
          "bounding_box": {
            "$ref": "#/components/schemas/BoundingBox"
          },
          "centroid": {
            "$ref": "#/components/schemas/Vec3",
            "description": "Centre of mass (mm)"
          },
          "surface_area": {
            "description": "Total surface area (mm^2)",
            "title": "Surface Area",
            "type": "number"
          },
          "topology": {
            "$ref": "#/components/schemas/TopologyCounts"
          },
          "volume": {
            "description": "Volume (mm^3)",
            "title": "Volume",
            "type": "number"
          }
        },
        "required": [
          "volume",
          "surface_area",
          "centroid",
          "bounding_box",
          "topology"
        ],
        "title": "ShapeProperties",
        "type": "object"
      },
      "SketchFeature": {
        "description": "``{\"type\": \"sketch\", \"version\": 1, \"params\": {...}}`` envelope.",
        "properties": {
          "params": {
            "$ref": "#/components/schemas/SketchParamsV1"
          },
          "type": {
            "const": "sketch",
            "title": "Type",
            "type": "string"
          },
          "version": {
            "const": 1,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "type",
          "version",
          "params"
        ],
        "title": "SketchFeature",
        "type": "object"
      },
      "SketchParamsV1": {
        "description": "Sketch on a plane \u2014 datum planes only in v1 (design \u00a72.1).\n\n``entities``/``constraints`` are structurally-open JSON objects in this\nslice: their final pydantic shapes are owned by the \"Sketch model +\nsolver API\" backlog item (design \u00a71.4). Sketch entities carry\nsketch-local string ids (``\"e1\"``, ...) per design \u00a72.4.",
        "properties": {
          "constraints": {
            "description": "Sketch constraints (shape finalized by the sketch-model item)",
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Constraints",
            "type": "array"
          },
          "entities": {
            "description": "Sketch entities (shape finalized by the sketch-model item)",
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Entities",
            "type": "array"
          },
          "plane": {
            "discriminator": {
              "mapping": {
                "datum_plane": "#/components/schemas/DatumPlaneRef",
                "feature": "#/components/schemas/FeatureRef"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/DatumPlaneRef"
              },
              {
                "$ref": "#/components/schemas/FeatureRef"
              }
            ],
            "title": "Plane"
          }
        },
        "required": [
          "plane",
          "entities",
          "constraints"
        ],
        "title": "SketchParamsV1",
        "type": "object"
      },
      "TessellateRequest": {
        "description": "Build a parametric shape and tessellate it to GLB.",
        "properties": {
          "linear_deflection": {
            "default": 0.1,
            "description": "Max distance (mm) between a curve and its tessellation; lower = finer mesh",
            "exclusiveMinimum": 0.0,
            "title": "Linear Deflection",
            "type": "number"
          },
          "params": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BoxParams"
              },
              {
                "$ref": "#/components/schemas/CylinderParams"
              }
            ],
            "description": "Parameters of the selected shape kind",
            "title": "Params"
          },
          "shape": {
            "description": "Shape kind; must match the params model",
            "enum": [
              "box",
              "cylinder"
            ],
            "title": "Shape",
            "type": "string"
          }
        },
        "required": [
          "shape",
          "params"
        ],
        "title": "TessellateRequest",
        "type": "object"
      },
      "TessellationMetadata": {
        "description": "Everything about a tessellation except the mesh itself.\n\nReturned as JSON by the ``.../tessellate/meta`` routes and carried,\ncompact-serialized, in the ``X-Loft-Properties`` response header of the\nbinary ``.../tessellate`` routes (geometry service and gateway proxy).",
        "properties": {
          "mesh": {
            "$ref": "#/components/schemas/MeshStats"
          },
          "properties": {
            "$ref": "#/components/schemas/ShapeProperties"
          }
        },
        "required": [
          "properties",
          "mesh"
        ],
        "title": "TessellationMetadata",
        "type": "object"
      },
      "TopologyCounts": {
        "description": "B-rep entity counts \u2014 asserted exactly by the golden-model suite.",
        "properties": {
          "edges": {
            "title": "Edges",
            "type": "integer"
          },
          "faces": {
            "title": "Faces",
            "type": "integer"
          },
          "shells": {
            "title": "Shells",
            "type": "integer"
          }
        },
        "required": [
          "faces",
          "edges",
          "shells"
        ],
        "title": "TopologyCounts",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "Vec3": {
        "description": "A 3D point/vector in model space (mm).",
        "properties": {
          "x": {
            "title": "X",
            "type": "number"
          },
          "y": {
            "title": "Y",
            "type": "number"
          },
          "z": {
            "title": "Z",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y",
          "z"
        ],
        "title": "Vec3",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Loft Geometry",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/evaluate": {
      "post": {
        "description": "Evaluate an ordered feature-tree prefix (feature-tree design \u00a74).\n\nStateless: documents sends the full ordered, validated, current-version\nfeature list (rollback bar already applied); the response is per-feature\nstatuses plus object-storage artifact references, under the strict-prefix\nrule (\u00a74.3 \u2014 first failure ``error``, the rest ``skipped``). A feature\nfailure is a **200 with per-feature errors**; the py-kit error envelope\nstays reserved for transport/validation failures of this call itself.",
        "operationId": "evaluate_api_v1_evaluate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluateTreeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluateTreeResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Evaluate",
        "tags": [
          "geometry"
        ]
      }
    },
    "/api/v1/export": {
      "post": {
        "description": "Build a parametric shape and export it as a STEP or STL download.",
        "operationId": "export_api_v1_export_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "model/step": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              },
              "model/stl": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "The exported CAD file: STEP AP214 part 21 (`model/step`, exact B-rep) or binary STL (`model/stl`, faceted mesh). `Content-Disposition` carries the suggested download filename. Byte-deterministic: identical requests produce identical files.",
            "headers": {
              "Content-Disposition": {
                "description": "attachment; filename=\"<shape>.<format>\"",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Export",
        "tags": [
          "geometry"
        ]
      }
    },
    "/api/v1/tessellate": {
      "post": {
        "description": "Build a parametric shape, tessellate it, return the GLB mesh.",
        "operationId": "tessellate_api_v1_tessellate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TessellateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "model/gltf-binary": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "Binary glTF (GLB) mesh of the requested shape. The `X-Loft-Properties` header carries `TessellationMetadata` as compact JSON (see `POST /api/v1/tessellate/meta` for the same payload as a typed JSON body).",
            "headers": {
              "X-Loft-Properties": {
                "description": "TessellationMetadata as compact JSON",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Tessellate",
        "tags": [
          "geometry"
        ]
      }
    },
    "/api/v1/tessellate/meta": {
      "post": {
        "description": "JSON twin of ``/tessellate``: mass properties + mesh stats, no mesh.",
        "operationId": "tessellate_meta_api_v1_tessellate_meta_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TessellateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TessellationMetadata"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
