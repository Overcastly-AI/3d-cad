# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/
dist/
*.tsbuildinfo
.pnpm-store/

# Local backups (scripts/backup.sh default destination). Never committed:
# they hold real user data and password hashes.
backups/

# Test / e2e artifacts
playwright-report/
test-results/

# Editors & OS
.DS_Store
.idea/
.vscode/

# Env files (12-factor: env-only config; commit only *.example)
.env
.env.*
!.env.example

# Per-agent build worktrees (isolation: worktree). They must never show up as
# untracked in the parent tree — the orchestrator uses a dirty tree as the
# tell that an agent died, and this would make it permanently true.
.claude/worktrees/

# Gauntlet fixture cache (scripts/gauntlet.py). Third-party STEP files fetched
# by URL + sha256 and NEVER redistributed — every fixture is all-rights-reserved
# or a named third party's upload (services/geometry/goldens-gauntlet/
# fixtures.json). This must stay ignored: committing one is the licence problem
# the fetch-and-verify design exists to avoid.
.gauntlet-cache/
