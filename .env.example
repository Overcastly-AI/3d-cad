# Loft compose environment — copy to `.env` and adjust (`.env` is gitignored).
# Every value here has the same default inside docker-compose.yml, so the
# stack runs without a .env at all. NO real secrets in this file, ever.

# --- datastore credentials (dev-only defaults; change for any real deploy) --
#
# READ THIS BEFORE DEPLOYING. The two passwords below are the compose DEFAULTS,
# which means they are published in this repository: anyone can read them.
#
# Since 2026-07-30 they ARE placeholders that something rejects. py-kit's
# datastore guard (packages/py-kit/src/py_kit/config.py) fails closed exactly
# like the gateway's JWT posture, off the SAME LOFT_ENV variable: unless
# LOFT_ENV is exactly "dev", any service whose POSTGRES_URL / REDIS_URL /
# S3_URL embeds a publicly-known default password — or whose MinIO secret is
# one — refuses to boot and names the variable to fix. Under LOFT_ENV=dev it
# warns instead (localhost is welcome to be insecure). The check lives in the
# application, not in compose interpolation, so it covers compose, Kubernetes
# and a bare `uvicorn` alike.
#
# So: for any deploy reachable by anything but localhost, set LOFT_ENV to your
# real environment name AND set both passwords — the stack will not start
# otherwise:
#   POSTGRES_PASSWORD=$(openssl rand -hex 24)
#   MINIO_ROOT_PASSWORD=$(openssl rand -hex 24)
#
# NOTE the corollary: leaving LOFT_ENV=dev (this file's default, below) is what
# opts you back into the insecure defaults. It is the one switch that matters.
POSTGRES_USER=loft
POSTGRES_PASSWORD=loft-dev-only
# Admin/bootstrap database; each schema-owning service gets its OWN database
# below (deploy/docker/postgres-init creates them on the volume's first boot).
# They MUST stay distinct: the gateway and documents alembic trees both start
# at revision "0001" in alembic's default alembic_version table.
POSTGRES_DB=loft
GATEWAY_DB=loft_gateway
DOCUMENTS_DB=loft_documents
MINIO_ROOT_USER=loft-minio
MINIO_ROOT_PASSWORD=loft-minio-dev-only
S3_BUCKET=loft

# --- host port mappings ------------------------------------------------------
# The datastores (Postgres, Redis, MinIO) bind to LOOPBACK by default: they are
# reachable from the host running compose, and from nowhere else. Until
# 2026-07-30 they published on 0.0.0.0 while carrying the default passwords
# above (engineering audit J4) — open port plus known password is materially
# worse than either alone. The gateway is the one intended public surface and is
# exempt.
#
# Override ONLY if you genuinely want a remotely reachable datastore, and change
# the passwords first. `scripts/check-compose.py` (invariant G4) fails if the
# committed file ever goes back to publishing a datastore on 0.0.0.0.
# BIND_IP=0.0.0.0
# scripts/dev-instance.sh <N> overrides these with an N*100 offset so parallel
# agent stacks don't collide. Leave defaults for a single local stack.
GATEWAY_PORT=8000
DOCUMENTS_PORT=8001
GEOMETRY_PORT=8002
DB_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- service behavior --------------------------------------------------------
# json (default, prod-shaped) or console (human-readable; dev override forces
# console already).
LOG_FORMAT=json

# --- deployment posture + auth / JWT (all three services) ---------------------
# LOFT_ENV is the ONE posture variable, read by every service (compose passes
# `${LOFT_ENV:-dev}` to gateway, documents and geometry). Setting it to exactly
# "dev" opts the whole stack into insecure local shortcuts: the repo-public JWT
# fallback secret AND the repo-public datastore passwords above. Anything else
# — unset, "production", "staging", even a typo — is treated as a real deploy,
# and each service refuses to boot on a shortcut it finds:
#   gateway   → JWT_SECRET required (>= 32 chars after trimming whitespace)
#   all       → POSTGRES_URL / REDIS_URL / S3_URL must not embed a known
#               default password, and must not embed a blank one
#   geometry  → S3_SECRET_ACCESS_KEY (= MINIO_ROOT_PASSWORD) likewise
LOFT_ENV=dev
# For any real deploy: set LOFT_ENV=production (or staging, …), real datastore
# passwords above, AND a real secret — `openssl rand -hex 32`.
# JWT_SECRET=

# --- observability / Prometheus (all three services) --------------------------
# Full operator guide: docs/OBSERVABILITY.md.
#
# Every service serves Prometheus text exposition at `/metrics` (rebuild-time
# histogram, rebuild-cache hit rate, feature errors by code, STEP import
# duration + refusals, HTTP rate/latency/status, process + GC). Set false to
# remove the endpoint AND the per-request instrumentation entirely.
METRICS_ENABLED=true
# WHO MAY SCRAPE. `/metrics` follows the same fail-closed posture as JWT_SECRET,
# off the same LOFT_ENV above:
#   LOFT_ENV=dev  → open, so a localhost stack just works (this file's default)
#   anything else → a bearer token is REQUIRED, and with METRICS_TOKEN unset the
#                   endpoint answers 404 — a real deploy never publishes its
#                   internals by accident, and a prober cannot even learn that
#                   metrics exist here.
# So for any real deploy, generate one and put the SAME value in your Prometheus
# scrape config's `authorization: credentials:` (example in
# docs/OBSERVABILITY.md):
#   METRICS_TOKEN=$(openssl rand -hex 32)
# NOTE this is deliberately a shared secret, not an IP allowlist: behind the
# reverse proxy you terminate TLS with, every request arrives from 127.0.0.1, so
# "allow loopback" would serve /metrics to the public internet while looking
# careful.
# METRICS_TOKEN=

# --- concurrency: how many people can use this at once ------------------------
# Measured 2026-08-01 (docs/PERF.md "CONCURRENCY", docs/OPERATIONS.md §6). The
# short version: ONE GEOMETRY WORKER SERVES ONE MODELER. OCP does not release
# the GIL, so a worker uses ~1.1 cores no matter how many people are on it —
# the second modeler doubles everyone's latency and the fifth also knocks over
# the rebuild cache. You scale by running MORE WORKERS, and workers only pay
# off if each modeler keeps landing on the SAME one.
#
# GEOMETRY_URL accepts a COMMA-SEPARATED list, and the gateway pins each
# modeler to one of them by rendezvous hash. Measured, 4 users / 4 workers /
# 4 cores, against one worker as the baseline:
#     with affinity      3.75x   (each modeler pays single-user latency)
#     round-robin        2.06x
#     random             1.21x   (what compose DNS / a shared socket give you)
# A worker that stops answering is skipped and its modelers are re-routed:
# slower (cold cache), never stranded.
#
# Run the replicas with `docker compose -f docker-compose.yml \
# -f docker-compose.scale.yml up -d` (four named geometry services, already
# wired to the line below) and set S3_URL so the mesh store is shared.
# GEOMETRY_URL=http://geometry-1:8002,http://geometry-2:8002,http://geometry-3:8002,http://geometry-4:8002

# How long the gateway waits for a geometry call before answering 504
# `upstream_timeout`. Was 30 s until 2026-08-01, and 30 s was too short for a
# part size this project ships goldens for: a 200-feature face pick costs 40.3 s
# cold, so it returned a 502 saying "Geometry service is unreachable" about a
# healthy worker. 90 s = that 40.3 s + the 20 s admission-queue ceiling below +
# headroom. Raise it if your parts are bigger; the 504 is honest either way (it
# says the work is still running and its progress is cached, so the retry is
# cheaper than the first attempt).
GEOMETRY_TIMEOUT_S=90

# Admission control on the geometry worker's OCCT routes — the bounded FIFO
# queue that makes overload DEGRADE instead of deleting the service. Sixteen
# simultaneous evaluates used to finish within 0.4 s of each other at ~40 s
# (processor sharing), delivering 1 of 16 inside a 30 s deadline where a FIFO
# queue delivers 11. Past the bound a request gets 503 `service_overloaded`
# with a `Retry-After` computed from that worker's own measured service time —
# refused BEFORE any CPU is spent, never silently dropped.
#   ADMISSION_CONCURRENCY  requests inside the OCCT section at once. Leave at 1:
#                          it is the worker's real core count (see above).
#   ADMISSION_QUEUE_DEPTH  how many may wait. Deeper = fewer 503s, longer waits.
#   ADMISSION_MAX_WAIT_S   longest wait before a request is refused instead.
#                          Keep GEOMETRY_TIMEOUT_S comfortably above this plus
#                          your worst cold rebuild, or an admitted request can
#                          still miss the gateway's deadline.
# ADMISSION_ENABLED=true
# ADMISSION_CONCURRENCY=1
# ADMISSION_QUEUE_DEPTH=8
# ADMISSION_MAX_WAIT_S=20
